
Command :

	# Numbered ACL configured in global config mode
		- R1(config)# access-list 1 {deny | permit} {network | host}
		- R1(config)# access-list 1 permit any --> Implexite allow

	# Named ACL configured with subcommands in a separate config mode
		- R1(config)# ip access-list standard < Name >
		- R1(config-std-nacl)# deny < host >
		- R1(config-std-nacl)# permit any --> Implexite allow

	# Modern IOS can configure Numbered ACL the same way as Named ACL
		- R1(config)# ip access-list standard <#>
		- R1(config-std-nacl)# deny < host >
		- R1(config-std-nacl)# permit any

	# Display Access lists
		- Do sh access-lists

	# Delete Named ACL entry
		R1:(config-std-nacl)# no entry-number

	# You can add and entries between other entries
	 	R1(config-std-nacl)#30 deny <network> <wildcard>
				     |
				 sequence number

	# Extended ACL commands 
		1.
			R1(config)# access-list <#> { permit | deny } protocol <src-ip> <dest-ip> 

		2. 
			R1(config)# ip access-list extended { name | number }
			R1(config-ext-nacl)# [seq-num] { permit | deny } protocol < src-ip> <dest-ip>

		3. Matching the Protcol command
			R1(config)# ip access-list extended {name | number}
			R1(config-ext-nacl)# ip access-list extended {name |number} {deny | permit | any}
			R1(config-ext-nacl)# ip access-list extended {name | number} {deny | permit | any} {Protcol | Number}
			R1(config-ext-nacl)# ip access-list extended {name | number} {deny | permit | any} {Protcol | Number} <src-ip> <dest-ip>

		4. Matching the source / destination IP address
			R1(config-ext-nacl)# deny tcp any 10.0.0.0 0.0.0.255
			         Permission <--|   |   |      |        |---> Wildcard mask  	
					Protocol<--|   |      |
						       |      |---> destination ip
						       |--> source ip	
		
		5. Matching the TCP/UDP port numbers
			R1(config-ext-nacl)# deny tcp src-ip < option > src-port-num dest-ip < option > dest-port-num
								  |
								  |----> eq = Equal
									 gt = Greater than
									 lt = Less than
									 neq = Not
									 range = 80 100    option
			ex :								  /
				R1(config-ext-nacl)# deny tcp any eq 80 host 1.1.1.1 eq 80
